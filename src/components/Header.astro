---
import HeaderLink from "./HeaderLink.astro";
import { SITE_TITLE } from "../consts";
---

<style type="text/css">
	@keyframes rwdcur69115 {
	0%,9.9%,100% {cursor:url(data:image/png;base64,) 5 6, auto;}
	10%,19.9% {cursor:url(data:image/png;base64,) 5 6, auto;}
	20%,29.9% {cursor:url(data:image/png;base64,) 5 6, auto;}
	30%,39.9% {cursor:url(data:image/png;base64,) 5 6, auto;}
	40%,49.9% {cursor:url(data:image/png;base64,) 5 6, auto;}
	50%,59.9% {cursor:url(data:image/png;base64,) 5 6, auto;}
	60%,69.9% {cursor:url(data:image/png;base64,) 5 6, auto;}
	70%,79.9% {cursor:url(data:image/png;base64,) 5 6, auto;}
	80%,89.9% {cursor:url(data:image/png;base64,) 5 6, auto;}
	90%,99.9% {cursor:url(data:image/png;base64,) 5 6, auto;}
	}
	body{
	animation:rwdcur69115 1s linear infinite forwards;
	}
	
	</style>
<header>
	<nav>
	  <div class="flex flex-col items-center gap-2 py-4 w-full">
		<img src="https://blob.gifcities.org/gifcities/7X4XHBYI7ECKIXOP4MQZCIIR53KMAJLT.gif" alt="">
		<h2 class="font-display text-2xl"><a href="/">{SITE_TITLE}</a></h2>
		<div class="flex flex-row gap-3">
		  <HeaderLink href="/">Home</HeaderLink>
		  <HeaderLink href="/photos">Photos</HeaderLink>
		  <HeaderLink href="/riders">Riders</HeaderLink>
		</div>
	  </div>
	</nav>
  </header>