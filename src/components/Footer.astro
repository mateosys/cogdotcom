---
const today = new Date();
import DitherImage from "../components/cog/DitherImage.astro";
---

<footer class="flex flex-col justify-center gap-2 mx-autos px-2 py-4 font-sans text-red-700">
	<figure class="items-center mx-auto px-4 py-2 w-fit lg:w-xl">
		<DitherImage
		  src="/photos/HZbloodthorns4.jpg"
		  alt="Evil Band"
		  dot={1}
		  mode="bayer"
		  light="#c0281f"
		  
		/><figcaption></figcaption>
	  </figure>
	<div class="mx-auto">
		&copy; {today.getFullYear()} Coven of Guilt All rights reserved.
	</div>
	
	
</footer>
