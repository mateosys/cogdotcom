---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import "../styles/global.css";
---


<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-black">
		<Header />
		<main class="block mx-auto text-center">
			<div class="gap-8 grid grid-cols-1">
				<div class="flex flex-row justify-center object-center">
					<img src="https://blob.gifcities.org/gifcities/XO4V7GZKIA24FCV5AL35OMGADZD5TGPJ.gif" alt="" class="w-12 h-auto">
					<a href="/rider/2 MAN TECH RIDER-1.pdf">Two Man Rider</a>
					<img src="https://blob.gifcities.org/gifcities/XO4V7GZKIA24FCV5AL35OMGADZD5TGPJ.gif" alt="" class="w-12 h-auto">
				</div>
				<div class="flex flex-row justify-center object-center">
					<img src="https://blob.gifcities.org/gifcities/XO4V7GZKIA24FCV5AL35OMGADZD5TGPJ.gif" alt="" class="w-12 h-auto">
					<a href="/rider/3 MAN TECH RIDER-2.pdf">Three Man Rider</a>
					<img src="https://blob.gifcities.org/gifcities/XO4V7GZKIA24FCV5AL35OMGADZD5TGPJ.gif" alt="" class="w-12 h-auto">
				</div>
			</div>
			
	
		</main>
		<Footer />
	</body>
</html>

