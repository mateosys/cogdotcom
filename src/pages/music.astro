---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import "../styles/global.css";
import "../styles/cog.css";
import { Image } from "astro:assets";
import keyImage from "../assets/photos/home.png";
import Divider from "../components/cog/Divider.astro";
import "../styles/cog.css";
import Frame from "../components/cog/Frame.astro";
import Player from "../components/cog/Player.astro";
import SpotifyEmbed from "../components/cog/SpotifyEmbed.astro";
import DitherImage from "../components/cog/DitherImage.astro";
const densities = ["12", "25", "50", "75", "88"];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="void-background">
    <Header />
    <main class="text-center">
      <h1 class="mb-4 font-bold text-2xl">Music</h1>
      <div class="mx-auto px-4 max-w-xl">
        <div class="gap-8 grid grid-cols-1">
            <div class="flex flex-row justify-center object-center">
                <img src="https://blob.gifcities.org/gifcities/XO4V7GZKIA24FCV5AL35OMGADZD5TGPJ.gif" alt="" class="w-12 h-auto">
                <a href="https://covenofguilt.bandcamp.com/album/coven-of-guilt-2">Bandcamp</a>
                <img src="https://blob.gifcities.org/gifcities/XO4V7GZKIA24FCV5AL35OMGADZD5TGPJ.gif" alt="" class="w-12 h-auto">
            </div>
            <div class="flex flex-row justify-center object-center">
                <img src="https://blob.gifcities.org/gifcities/XO4V7GZKIA24FCV5AL35OMGADZD5TGPJ.gif" alt="" class="w-12 h-auto">
               <a href="https://open.spotify.com/artist/0iuWWjGHMb8o2vFIfv9E8e">Spotify</a>
                <img src="https://blob.gifcities.org/gifcities/XO4V7GZKIA24FCV5AL35OMGADZD5TGPJ.gif" alt="" class="w-12 h-auto">
            </div>
            <div class="flex flex-row justify-center object-center">
                <img src="https://blob.gifcities.org/gifcities/XO4V7GZKIA24FCV5AL35OMGADZD5TGPJ.gif" alt="" class="w-12 h-auto">
               <a href="https://music.apple.com/us/artist/coven-of-guilt/1687791731">Apple Music</a>
                <img src="https://blob.gifcities.org/gifcities/XO4V7GZKIA24FCV5AL35OMGADZD5TGPJ.gif" alt="" class="w-12 h-auto">
            </div>
        </div>
         
      
      </div>
      
    </main>
    <Footer />
  </body>
</html>
