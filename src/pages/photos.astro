---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import "../styles/global.css";
import DitherImage from "../components/cog/DitherImage.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Press photos | Coven of Guilt"
      description="Press photos, free to download."
    />
  </head>
  <body class="bg-black">
    <Header />
    <main class="text-center">
      <h1 class="font-bold text-2xl">Press Photos</h1>
      <img
        class="items-center mx-auto px-4 py-2"
        src="https://blob.gifcities.org/gifcities/35KDEERUGB37DKCGH2CFXUIGJJROMR7M.gif"
        alt=""
      />
      <div
        class="gap-1 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 px-4 py-4"
      >
        <DitherImage
          src="/photos/CoG.jpg"
          alt="Evil Band"
          dot={1}
          mode="bayer"
          light="#c0281f"
          reveal
        />
        <DitherImage
          src="/photos/CoGbw.jpg"
          alt="Evil Band"
          dot={1}
          mode="bayer"
          light="#c0281f"
          reveal
        />
        <DitherImage
          src="/photos/DSC09052.JPG"
          alt="Evil Band"
          dot={1}
          mode="bayer"
          light="#c0281f"
          reveal
        />
        <DitherImage
          src="/photos/DSC09075.JPG"
          alt="Evil Band"
          dot={1}
          mode="bayer"
          light="#c0281f"
          reveal
        />
        <DitherImage
        src="/photos/DSC09176.JPG"
        alt="Evil Band"
        dot={1}
        mode="bayer"
        light="#c0281f"
        reveal
      />
      <DitherImage
        src="/photos/DSC09119.JPG"
        alt="Evil Band"
        dot={1}
        mode="bayer"
        light="#c0281f"
        reveal
      />
      </div>
    </main>
    <Footer />
  </body>
</html>
