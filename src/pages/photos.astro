---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import "../styles/global.css";
// Add one line per photo. "file" is the name inside public/downloads/photos/
const photos = [
  { file: 'live-echo-2026.jpg', title: 'Live at the Echo', credit: 'Photo: Name' },
  { file: 'CoG.jpg',  title: 'Band portrait',    credit: 'Photo: Name' },
];
---

<!doctype html>
<html lang="en">
	<head>
        <BaseHead title="Press photos | Coven of Guilt" description="Press photos, free to download." />	</head>
	<body class="bg-slate-950">
		<Header />
		<main class="text-center">
			<h1 class="font-bold text-2xl">Press Photos</h1>
            <img class="items-center mx-auto px-4 py-2" src="https://blob.gifcities.org/gifcities/35KDEERUGB37DKCGH2CFXUIGJJROMR7M.gif" alt="">
            <div class="gap-3 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 px-4 py-4">
                <img src="public/photos/CoG.jpg" alt="">
                <img src="public/photos/CoGbw.jpg" alt="">
                <img src="public/photos/DSC09052.JPG" alt="">
                <img src="public/photos/DSC09075.JPG" alt="">
                
            </div>
       
           
		</main>
		<Footer />
	</body>
</html>


 
